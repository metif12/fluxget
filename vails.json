{
	"name": "Fluxget",
	"version": "0.1.0",
	"asset_root": "frontend",
	"windows": [
		{
			"label": "main",
			"title": "Fluxget",
			"width": 1360,
			"height": 880
		}
	],
	"capabilities": [
		{
			"id": "fluxget-core",
			"windows": ["main"],
			"commands": [
				"fluxget.ping",
				"fluxget.info",
				"fluxget.health",
				"fluxget.tick",
				"fluxget.add"
			],
			"asset_roots": ["frontend"],
			"platforms": []
		},
		{
			"id": "fluxget-control",
			"_comment": "Row operations. A SEPARATE capability from fluxget-core on purpose: the grant is the security boundary, and 'can pause a download' is a smaller promise than 'can add one'. A script injected into the window can do exactly what this list says and nothing else.",
			"windows": ["main"],
			"commands": [
				"fluxget.pause",
				"fluxget.resume",
				"fluxget.remove",
				"fluxget.retry",
				"fluxget.move",
				"fluxget.pause_all",
				"fluxget.resume_all",
				"fluxget.forget_all",
				"fluxget.set_item_options",
				"fluxget.details"
			],
			"asset_roots": ["frontend"],
			"platforms": []
		},
		{
			"id": "fluxget-settings",
			"_comment": "Reading and writing preferences. Split out because it is the only capability that changes how EVERY future download behaves, and because a settings write is the one control command that reaches outside the queue.",
			"windows": ["main"],
			"commands": [
				"fluxget.get_settings",
				"fluxget.set_settings"
			],
			"asset_roots": ["frontend"],
			"platforms": []
		},
		{
			"id": "native-dialogs",
			"windows": ["main"],
			"commands": ["dialog.open", "dialog.save", "dialog.message"],
			"asset_roots": [],
			"platforms": []
		},
		{
			"id": "host-info",
			"windows": ["main"],
			"commands": ["os_info.get"],
			"asset_roots": [],
			"platforms": []
		}
	],
	"bundle": {
		"name": "Fluxget",
		"icon": "",
		"windows_dll_side_by_side": true
	}
}
