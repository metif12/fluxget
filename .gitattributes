# Keep text files LF in the repository; Windows checkouts get CRLF.
* text=auto eol=lf

# V source and web assets are text
*.v      text eol=lf
*.json   text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.md     text eol=lf
*.ps1    text eol=crlf
*.lock   text eol=lf

# Never touch binaries
*.exe    binary
*.dll    binary
*.zip    binary
*.ico    binary
*.png    binary
*.woff2  binary
*.torrent binary
