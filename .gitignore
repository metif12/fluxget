# V build outputs
/fluxget
/fluxget.exe
*.exe
.vmodules/
.v/
# V's per-project build cache, created by running the compiler from the repo
# root. Regenerated; never source.
.cache/
*.tmp

# Build staging: the exe, the five webview DLLs and the packed frontend.
# Everything here is regenerated by scripts/build.ps1.
/build/

# Extension build output (scripts/ext.ps1)
/extension/dist/

# aria2c is fetched by scripts/fetch-aria2.ps1, never committed (GPL)
/runtime/

# Where aria2c downloads land, by default (aria2ctl.conf_for). The default is
# under the project so a dev run needs no configuration and a `rm -rf` is a
# complete cleanup; a real install points --dir at the user's Downloads folder
# in Phase 3's settings.
/downloads/

# Development logs
*.log
logs/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
